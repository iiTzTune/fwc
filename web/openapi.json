{
  "openapi": "3.1.0",
  "info": {
    "title": "Field Wireless Companion",
    "version": "0.1.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Core session and service counters",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/networks": {
      "get": {
        "summary": "Latest record for each observed network",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Networks"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "string"
            },
            "description": "Exclusive network key from the preceding page."
          }
        ]
      }
    },
    "/api/peers": {
      "get": {
        "summary": "Most recently reported companions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Peers"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/plugins": {
      "get": {
        "summary": "Most recently reported plugin states",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plugins"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Editable observation settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save observation settings for the next worker start",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Stream committed activity in sequence order",
        "parameters": [
          {
            "in": "header",
            "name": "Last-Event-ID",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "UTF-8 activity events; each data line conforms to Event. Sequence IDs support replay.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-event-schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Config": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 233
            },
            "minItems": 1,
            "maxItems": 233
          },
          "dwell_ms": {
            "type": "integer",
            "minimum": 10,
            "maximum": 60000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 128,
            "maximum": 2147483648
          },
          "file_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "allow_ssids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32,
              "description": "At most 32 UTF-8 bytes."
            }
          },
          "deny_ssids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32,
              "description": "At most 32 UTF-8 bytes."
            }
          }
        },
        "required": [
          "channels",
          "dwell_ms",
          "max_bytes",
          "file_count",
          "allow_ssids",
          "deny_ssids"
        ],
        "additionalProperties": false
      },
      "Status": {
        "type": "object",
        "properties": {
          "committed": {
            "type": "integer",
            "minimum": 0
          },
          "clients": {
            "type": "integer",
            "minimum": 0
          },
          "dropped_metrics": {
            "type": "integer",
            "minimum": 0
          },
          "overflows": {
            "type": "integer",
            "minimum": 0
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "pid": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "starts": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "pid",
                "starts"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "committed",
          "clients",
          "dropped_metrics",
          "overflows",
          "services"
        ],
        "additionalProperties": false
      },
      "Network": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string"
          },
          "ssid": {
            "type": "string"
          },
          "owned": {
            "type": "boolean"
          },
          "channel": {
            "type": "integer",
            "minimum": 0
          },
          "time_ns": {
            "type": "integer",
            "minimum": 0
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "network",
          "ssid",
          "owned",
          "channel",
          "time_ns",
          "seq"
        ],
        "additionalProperties": false
      },
      "Networks": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Network"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next"
        ],
        "additionalProperties": false
      },
      "Peers": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "peer": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "peer",
                "name",
                "seq"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Plugins": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "running",
                    "waiting",
                    "stopped",
                    "unavailable"
                  ]
                },
                "detail": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "state",
                "detail",
                "seq"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "seq",
          "id",
          "topic",
          "data"
        ],
        "additionalProperties": false
      }
    }
  }
}
