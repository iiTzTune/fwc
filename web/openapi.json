              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plugins"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Editable observation settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save observation settings for the next worker start",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Stream committed activity in sequence order",
        "parameters": [
          {
            "in": "header",
            "name": "Last-Event-ID",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "UTF-8 activity events; each data line conforms to Event. Sequence IDs support replay.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-event-schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/captures": {
      "get": {
        "summary": "Retained capture files",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "size": {
                            "type": "integer"
                          },
                          "updated_ns": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "name",
                          "size",
                          "updated_ns"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/captures/{name}": {
      "get": {
        "summary": "Download a retained capture",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.tcpdump.pcap": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "File unavailable"
          }
        },
        "parameters": [
          {
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "in": "path"
          }
        ]
      }
    },
    "/api/map": {
      "get": {
        "summary": "Recent location-tagged network observations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "seq": {
                            "type": "integer"
                          },
                          "network": {
                            "type": "string"
                          },
                          "ssid": {
                            "type": "string"
                          },
                          "time_ns": {
                            "type": "integer"
                          },
                          "latitude": {
                            "type": "number"
                          },
                          "longitude": {
                            "type": "number"
                          },
                          "fix_time_ns": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "seq",
                          "network",
                          "ssid",
                          "time_ns",
                          "latitude",
                          "longitude",
                          "fix_time_ns"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/plugin-permissions": {
      "get": {
        "summary": "List requested and granted permissions per installed plugin",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermissionList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Set one declared plugin permission",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstalledPluginGrants"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PermissionChange"
              }
            }
          }
        }
      }
    },
    "/api/power": {
      "get": {
        "summary": "Read power capability and external supply state",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PowerStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local request required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Device temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Config": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 233
            },
            "minItems": 1,
            "maxItems": 233
          },
          "dwell_ms": {
            "type": "integer",
            "minimum": 10,
            "maximum": 60000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 128,
            "maximum": 2147483648
          },
          "file_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "allow_ssids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32,
              "description": "At most 32 UTF-8 bytes."
            }
          },
          "deny_ssids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32,
              "description": "At most 32 UTF-8 bytes."
            }
          }
        },
        "required": [
          "channels",
          "dwell_ms",
          "max_bytes",
          "file_count",
          "allow_ssids",
          "deny_ssids"
        ],
        "additionalProperties": false
      },
      "Status": {
        "type": "object",
        "properties": {
          "committed": {
            "type": "integer",
            "minimum": 0
          },
          "clients": {
            "type": "integer",
            "minimum": 0
          },
          "dropped_metrics": {
            "type": "integer",
            "minimum": 0
          },
          "overflows": {
            "type": "integer",
            "minimum": 0
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "pid": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "starts": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "pid",
                "starts"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "committed",
          "clients",
          "dropped_metrics",
          "overflows",
          "services"
        ],
        "additionalProperties": false
      },
      "Network": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string"
          },
          "ssid": {
            "type": "string"
          },
          "owned": {
            "type": "boolean"
          },
          "channel": {
            "type": "integer",
            "minimum": 0
          },
          "time_ns": {
            "type": "integer",
            "minimum": 0
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "network",
          "ssid",
          "owned",
          "channel",
          "time_ns",
          "seq"
        ],
        "additionalProperties": false
      },
      "Networks": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Network"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next"
        ],
        "additionalProperties": false
      },
      "Peers": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "peer": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "peer",
                "name",
                "seq"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Plugins": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "running",
                    "waiting",
                    "stopped",
                    "unavailable"
                  ]
                },
                "detail": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0
                },
                "error": {
                  "$ref": "#/components/schemas/PermissionDenied"
                }
              },
              "required": [
                "name",
                "state",
                "detail",
                "seq"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "seq",
          "id",
          "topic",
          "data"
        ],
        "additionalProperties": false
      },
      "PluginPermission": {
        "type": "string",
        "enum": [
          "status.read",
          "networks.read",
          "widget.write",
          "export.write",
          "display.write",
          "radio.tx",
          "radio.config",
          "radio.raw",
          "network.out"
        ]
      },
      "PermissionDenied": {
        "type": "object",
        "properties": {
          "code": {
            "const": "permission_denied"
          },
          "permission": {
            "$ref": "#/components/schemas/PluginPermission"
          }
        },
        "required": [
          "code",
          "permission"
        ],
        "additionalProperties": false
      },
      "InstalledPluginGrants": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "requested": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PluginPermission"
            },
            "uniqueItems": true
          },
          "granted": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PluginPermission"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "requested",
          "granted"
        ],
        "additionalProperties": false
      },
      "PermissionList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstalledPluginGrants"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "PermissionChange": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "permission": {
            "$ref": "#/components/schemas/PluginPermission"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "permission",
          "enabled"
        ],
        "additionalProperties": false
      },
      "PowerStatus": {
        "type": "object",
        "properties": {
          "capability": {
            "enum": [
              "none",
              "coarse",
              "full"
            ]
          },
          "external_power": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "charge_state": {
            "enum": [
              "unknown",
              "discharging",
              "charging",
              "full"
            ]
          },
          "millivolts": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "capability",
          "external_power",
          "charge_state",
          "millivolts"
        ],
        "additionalProperties": false
      }
    }
  }
}
