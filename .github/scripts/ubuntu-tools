#!/usr/bin/env bash
# Hosted Ubuntu jobs use official HTTPS archives for this job's tool downloads.
set -euo pipefail
source /etc/os-release
list="$RUNNER_TEMP/fwc-ubuntu.list"
for pocket in "$VERSION_CODENAME" "$VERSION_CODENAME-updates" "$VERSION_CODENAME-security"; do
    echo "deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] https://archive.ubuntu.com/ubuntu $pocket main universe"
done > "$list"
options=(-o "Dir::Etc::sourcelist=$list" -o Dir::Etc::sourceparts=- -o Acquire::Retries=3 -o Acquire::https::Timeout=30)
sudo apt-get "${options[@]}" update
sudo apt-get "${options[@]}" install -y --no-install-recommends "$@"
