#!/bin/sh
set -eu
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t tmpfs tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs tmpfs /var/log
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
ip link set lo up
# Resolve all four partition paths from the fixed GPT labels for the updater.
mkdir -p /dev/disk/by-partlabel
for file in /sys/class/block/*/uevent; do
    name=$(sed -n 's/^PARTNAME=//p' "$file")
    case "$name" in FWC-A|FWC-B|FWC-BOOT|FWC-DATA)
        node=$(sed -n 's/^DEVNAME=//p' "$file")
        ln -sf "/dev/$node" "/dev/disk/by-partlabel/$name" ;;
    esac
done
mount -t ext4 /dev/disk/by-partlabel/FWC-DATA /var/lib/fwc
mount -t vfat /dev/disk/by-partlabel/FWC-BOOT /boot/efi
if [ ! -s /var/lib/fwc/device-id ]; then
    cat /proc/sys/kernel/random/uuid > /var/lib/fwc/device-id.new
    mv /var/lib/fwc/device-id.new /var/lib/fwc/device-id
    sync
fi
if [ -s /var/lib/fwc/shadow ]; then mount --bind /var/lib/fwc/shadow /etc/shadow; fi
# Resolve cold-plugged hardware and use mdev for subsequent hotplug events.
echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || :
mdev -s
for alias in /sys/bus/*/devices/*/modalias; do
    [ -r "$alias" ] && modprobe -b "$(cat "$alias")" 2>/dev/null || :
done
/usr/lib/fwc/health.sh /var/lib/fwc/bus.sock &
python3 /usr/lib/fwc/report.py &
