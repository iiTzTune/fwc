#!/bin/busybox sh
export PATH=/sbin:/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
for module in virtio_pci virtio_blk ahci sd_mod mmc_block sdhci_pci sdhci_acpi xhci_pci usb_storage uas ext4 vfat; do
    modprobe "$module" 2>/dev/null || :
done
for word in $(cat /proc/cmdline); do
    case "$word" in root=PARTUUID=*) uuid=${word#root=PARTUUID=} ;; esac
done
for attempt in $(seq 1 30); do
    root=$(blkid -t "PARTUUID=$uuid" -o device | head -1)
    if [ -b "$root" ] && mount -t ext4 -o ro "$root" /newroot; then
        for dir in dev proc sys; do mount --move "/$dir" "/newroot/$dir"; done
        exec switch_root /newroot /sbin/init
    fi
    sleep 1
done
echo "FWC could not mount its selected slot. Restarting."
reboot -f
